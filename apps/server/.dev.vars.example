# Local dev only: trusts a web app on localhost, which production must not.
TRUSTED_ORIGINS=http://localhost:3000,edgebase://,https://appleid.apple.com
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The Firebase service account key JSON, on one line.
FCM_SERVICE_ACCOUNT=
# Optional: Cloudflare Turnstile secret; when set, sign-up and email-sending routes need a token.
TURNSTILE_SECRET_KEY=
PUSH_API_KEY=
