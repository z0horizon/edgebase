{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edgebase",
  "main": "src/index.ts",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  // Logs and traces are sampled so high traffic stays within the included observability quota.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  // Every authenticated request reads its session from D1; running near the database cuts that round trip.
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgebase-db",
      "database_id": "local",
      "migrations_dir": "../../packages/core/migrations"
    },
    {
      "binding": "INBOX_DB",
      "database_name": "edgebase-inbox",
      "database_id": "local-inbox",
      "migrations_dir": "../../packages/core/migrations-inbox"
    }
  ],
  "ratelimits": [
    { "name": "AUTH_RL", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Per user, apart from AUTH_RL, so topic changes never spend an IP's sign-in attempts.
    { "name": "TOPIC_RL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    // Per user on the signed-in /v1 routes, so one account calling in a loop cannot run up
    // Worker requests or D1 writes: every call, and separately every call that writes.
    { "name": "USER_RL", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "USER_WRITE_RL", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  "queues": {
    "producers": [
      { "binding": "PUSH_QUEUE", "queue": "edgebase-push" },
      { "binding": "PUSH_DLQ", "queue": "edgebase-push-dlq" }
    ],
    "consumers": [
      {
        "queue": "edgebase-push",
        // Each message fans out to <= 500 FCM requests; 5 per batch (<= 2,500 subrequests) stays
        // well under Workers Paid's 10,000 subrequest limit while coalescing push_stats writes.
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "edgebase-push-dlq"
      }
    ]
  },
  "send_email": [{ "name": "MAIL" }],
  // The /admin page; files here are served before the Worker runs.
  "assets": { "directory": "./public" },
  // Every minute: dispatch due scheduled pushes. Hourly: retention cleanup in small budgets.
  "triggers": { "crons": ["* * * * *", "17 * * * *"] },
  "vars": {
    // The product name in mail subjects, authenticator and passkey labels and the admin page.
    "APP_NAME": "EdgeBase",
    "BASE_URL": "http://localhost:8787",
    "TRUSTED_ORIGINS": "edgebase://,https://appleid.apple.com",
    "APP_SCHEME": "edgebase",
    "INBOX_TTL_DAYS": "30",
    // "off" turns email and password sign-in, sign-up, password reset and verification mail off.
    "EMAIL_PASSWORD": "on",
    "MAIL_FROM": "no-reply@example.com"
  }
}
