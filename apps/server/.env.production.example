# Template for .env.production, the only place deploy values and secrets live.
# `pnpm bootstrap` creates .env.production from this list, asks for what is missing and fills in
# what it can. Never commit .env.production.

# Names the worker, its D1 databases (<name>-db, <name>-inbox, and any you add to wrangler.jsonc) and
# queues (<name>-push, <name>-push-dlq).
PROJECT_NAME=
# Only needed when your Cloudflare login has several accounts; bootstrap asks and fills it in.
CLOUDFLARE_ACCOUNT_ID=

# The Worker's public https:// URL, e.g. https://<PROJECT_NAME>.<your-subdomain>.workers.dev
BASE_URL=
# The native apps' URL scheme. Default: PROJECT_NAME.
APP_SCHEME=
# Comma list: web origins allowed to call with cookies, <APP_SCHEME>://, https://appleid.apple.com.
# Never localhost here; local dev sets its own in .dev.vars.
TRUSTED_ORIGINS=
# Sender address on a domain set up for Cloudflare Email Sending.
MAIL_FROM=
INBOX_TTL_DAYS=

# Written by bootstrap after it finds or creates the databases: one <binding>_ID per D1 database.
DB_ID=
INBOX_DB_ID=

# Generated by bootstrap when empty.
BETTER_AUTH_SECRET=
PUSH_API_KEY=

# The first admin, created by bootstrap or `pnpm admin:create --remote`; an empty password is
# generated. Rerun after changing either to reset that admin's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional sign-in providers: a provider is off while its ID or secret is empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# node apps/server/scripts/apple-secret.mjs <teamId> <keyId> <servicesId> AuthKey.p8 (expires after 6 months)
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: Cloudflare Turnstile secret key. Set it and sign-up, password reset and resend
# verification need an x-captcha-response token from the Turnstile widget.
TURNSTILE_SECRET_KEY=

# Optional: path to the Firebase service account JSON, absolute or relative to apps/server.
# Empty turns /v1/push off (503).
FCM_SERVICE_ACCOUNT_FILE=
