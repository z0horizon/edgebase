# Template for .env.production, the only place deploy values and secrets live.
# `pnpm bootstrap` creates .env.production from this list, asks for what is missing and fills in
# what it can. Never commit .env.production.

# Names the worker, its D1 databases (<name>-db, <name>-inbox, and any you add to wrangler.jsonc) and
# queues (<name>-push, <name>-push-dlq).
PROJECT_NAME=
# The product name people see: mail subjects, authenticator and passkey labels, the admin page.
# Bootstrap sets it to PROJECT_NAME when empty; at most 40 characters.
APP_NAME=
# Only needed when your Cloudflare login has several accounts; bootstrap asks and fills it in.
CLOUDFLARE_ACCOUNT_ID=

# The Worker's public https:// URL, e.g. https://<PROJECT_NAME>.<your-subdomain>.workers.dev,
# or https://<CUSTOM_DOMAIN> when that is set.
BASE_URL=
# Optional: a hostname on a zone in your Cloudflare account, e.g. api.example.com. Deploy then
# serves the Worker there and turns its workers.dev and preview URLs off, so the zone's WAF and
# rate limiting rules see every request (docs/deployment.md). BASE_URL must be https://<this>.
CUSTOM_DOMAIN=
# The native apps' URL scheme. Default: PROJECT_NAME.
APP_SCHEME=
# Comma list: web origins allowed to call with cookies, <APP_SCHEME>://, https://appleid.apple.com.
# Never localhost here; local dev sets its own in .dev.vars.
TRUSTED_ORIGINS=
# Sender address on a domain set up for Cloudflare Email Sending.
MAIL_FROM=
INBOX_TTL_DAYS=
# on (default when empty) or off. Off closes email and password sign-in, sign-up, password reset
# and verification mail, for apps that sign in only with Google, Apple, GitHub or passkeys.
# The first admin then signs in with a provider once, and `pnpm admin:create --remote` promotes them.
# Admins who sign in with a password must link a provider or add a passkey before you turn it off.
EMAIL_PASSWORD=
# on (default when empty) or off. On, an active session's lastActiveAt and current network
# (IP, ASN, country, city) are refreshed in the background: at once on a new country, hourly on a
# new ASN, else every 6 hours. Off saves those D1 writes; sessions then show the time and network
# of sign-in only, plus the daily expiry refresh. Sign-in alerts and session revocation still work.
SESSION_ACTIVITY=
# 1 (default when empty) to 14. An active session's 30-day expiry is pushed forward at most once
# every this many days, which costs 2 D1 writes each time. A higher number saves writes; a session
# left unused for 30 days minus this many days may then already have expired.
SESSION_REFRESH_DAYS=

# Written by bootstrap after it finds or creates the databases: one <binding>_ID per D1 database.
DB_ID=
INBOX_DB_ID=

# Generated by bootstrap when empty.
BETTER_AUTH_SECRET=
PUSH_API_KEY=

# The first admin, created by bootstrap or `pnpm admin:create --remote`; an empty password is
# generated. Rerun after changing either to reset that admin's password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional sign-in providers: a provider is off while its ID or secret is empty.
# GOOGLE_CLIENT_ID takes the web client ID first, plus optional comma-separated iOS/Android IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# node apps/server/scripts/apple-secret.mjs <teamId> <keyId> <servicesId> AuthKey.p8 (expires after 6 months)
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile secret key (dashboard > Turnstile > add a widget, free). Required unless
# EMAIL_PASSWORD=off: sign-up, password reset and resend verification then need an
# x-captcha-response token from the widget, so bots cannot send mail at your cost.
TURNSTILE_SECRET_KEY=

# Optional: path to the Firebase service account JSON, absolute or relative to apps/server.
# Empty turns /v1/push off (503).
FCM_SERVICE_ACCOUNT_FILE=
