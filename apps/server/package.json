{
  "name": "@edgebase/server",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "wrangler dev",
    "deploy": "pnpm --filter @edgebase/admin build && node scripts/prod-config.mjs && wrangler deploy -c wrangler.production.jsonc",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"scripts/*.test.mjs\"",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "db:migrate:remote": "node scripts/prod-config.mjs && node scripts/migrate.mjs --remote -c wrangler.production.jsonc",
    "admin:create": "node scripts/admin.mjs"
  },
  "dependencies": {
    "@edgebase/core": "workspace:*",
    "hono": "^4.13.17",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "better-auth": "^1.7.18",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
