{
  "name": "edgebase",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "wrangler dev",
    "admin:dev": "vite --config admin/vite.config.ts",
    "admin:build": "vite build --config admin/vite.config.ts",
    "deploy": "pnpm admin:build && node scripts/prod-config.mjs && wrangler deploy -c wrangler.production.jsonc",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p admin",
    "lint": "biome check .",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply INBOX_DB --local",
    "db:migrate:remote": "node scripts/prod-config.mjs && wrangler d1 migrations apply DB --remote -c wrangler.production.jsonc && wrangler d1 migrations apply INBOX_DB --remote -c wrangler.production.jsonc"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.18",
    "better-auth": "^1.7.18",
    "hono": "^4.13.17",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
}
