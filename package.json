{
  "name": "edgebase",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "dev": "wrangler dev",
    "deploy": "node scripts/prod-config.mjs && wrangler deploy -c wrangler.production.jsonc",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run && node --test \"scripts/*.test.mjs\"",
    "db:migrate:local": "wrangler d1 migrations apply DB --local && wrangler d1 migrations apply INBOX_DB --local",
    "db:migrate:remote": "node scripts/prod-config.mjs && wrangler d1 migrations apply DB --remote -c wrangler.production.jsonc && wrangler d1 migrations apply INBOX_DB --remote -c wrangler.production.jsonc"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.18",
    "better-auth": "^1.7.18",
    "hono": "^4.13.17",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0"
}
