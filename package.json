{
  "name": "edgebase",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "bootstrap": "pnpm --filter @edgebase/server run bootstrap",
    "dev": "pnpm --filter @edgebase/server run dev",
    "admin:dev": "pnpm --parallel --filter @edgebase/server --filter @edgebase/admin run dev",
    "deploy": "pnpm --filter @edgebase/server run deploy",
    "types": "pnpm --filter @edgebase/server run types",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "test": "pnpm -r test",
    "db:migrate:local": "pnpm --filter @edgebase/server run db:migrate:local",
    "db:migrate:remote": "pnpm --filter @edgebase/server run db:migrate:remote"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6"
  },
  "packageManager": "pnpm@12.18.0"
}
